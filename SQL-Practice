FROM penjualan
GROUP BY produk
ORDER BY total_penjualan DESC
LIMIT 2;

🔥 Apa itu CTE (WITH)?
CTE = membuat tabel sementara di dalam query.
WITH total_produk AS (
    SELECT produk, SUM(total) AS total_penjualan
    FROM penjualan
    GROUP BY produk
)
SELECT *,
RANK() OVER(ORDER BY total_penjualan DESC) AS ranking
FROM total_produk;

👉 Tampilkan produk dengan total penjualan > rata-rata semua produk
WITH total_produk AS (
    SELECT produk, SUM(total) AS total_penjualan
    FROM penjualan
    GROUP BY produk
),
rata_produk AS (
    SELECT AVG(total_penjualan) AS rata_rata
    FROM total_produk
)
SELECT *
FROM total_produk
WHERE total_penjualan > (SELECT rata_rata FROM rata_produk);

Buat kolom kategori dari nilai penjualan:
5 juta → "Laris"
2–5 juta → "Sedang"
< 2 juta → "Kurang"

SELECT produk, total,
CASE
    WHEN total > 5000000 THEN 'Laris'
    WHEN total >= 2000000 THEN 'Sedang'
    ELSE 'Kurang'
END AS kategori_penjualan
FROM penjualan;

mengkategorikan per produk 
SELECT produk,
SUM(total) AS total_penjualan,
CASE
    WHEN SUM(total) > 10000000 THEN 'Best Seller'
    WHEN SUM(total) > 5000000 THEN 'Good'
    ELSE 'Low'
END AS kategori_produk
FROM penjualan
GROUP BY produk;

