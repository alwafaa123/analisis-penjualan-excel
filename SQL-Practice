👉 Tampilkan transaksi + kolom status_jumlah
jumlah >= 5 → "Banyak"
jumlah 2–4 → "Sedang"
jumlah < 2 → "Sedikit

SELECT produk, total,
CASE
    WHEN jumlah >= 5 THEN 'Banyak'
    WHEN jumlah BETWEEN 2 AND 4 THEN 'Sedang'
    WHEN jumlah < 2 THEN 'Sedikit'
    ELSE 'Kurang'
END AS kategori_penjualan
FROM penjualan;


SELECT kota,

SUM(CASE WHEN jumlah >= 5 THEN total ELSE 0 END) AS omzet_banyak,
SUM(CASE WHEN jumlah BETWEEN 2 AND 4 THEN total ELSE 0 END) AS omzet_sedang,
SUM(CASE WHEN jumlah < 2 THEN total ELSE 0 END) AS omzet_sedikit

FROM penjualan
GROUP BY kota;

🎯 Query lengkap CASE + COUNT + AVG
SELECT 
    kota,

    -- total semua transaksi
    COUNT(*) AS total_transaksi,

    -- rata-rata jumlah semua transaksi
    AVG(jumlah) AS rata_jumlah_barang,

    -- =============================
    -- COUNT berdasarkan kategori
    -- =============================
    SUM(CASE WHEN jumlah >= 5 THEN 1 ELSE 0 END) AS trx_banyak,
    SUM(CASE WHEN jumlah BETWEEN 2 AND 4 THEN 1 ELSE 0 END) AS trx_sedang,
    SUM(CASE WHEN jumlah < 2 THEN 1 ELSE 0 END) AS trx_sedikit,

    -- =============================
    -- AVG berdasarkan kategori
    -- =============================
    AVG(CASE WHEN jumlah >= 5 THEN jumlah END) AS avg_banyak,
    AVG(CASE WHEN jumlah BETWEEN 2 AND 4 THEN jumlah END) AS avg_sedang,
    AVG(CASE WHEN jumlah < 2 THEN jumlah END) AS avg_sedikit

FROM penjualan
GROUP BY kota;

👉 SUM + CASE WHEN
SELECT 
    kota,

    SUM(CASE WHEN produk = 'Laptop' THEN total ELSE 0 END) AS Laptop,
    SUM(CASE WHEN produk = 'HP' THEN total ELSE 0 END) AS HP

FROM penjualan
GROUP BY kota;

MySQL tidak punya keyword PIVOT, jadi kita pakai trik:
