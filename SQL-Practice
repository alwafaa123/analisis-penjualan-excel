🔥 Apa itu WINDOW FUNCTION?
Window function = fungsi yang menghitung tanpa menghilangkan baris asli.

Memberi nomor urut setiap baris.
SELECT kota, produk, total,
ROW_NUMBER() OVER() AS nomor_urut
FROM penjualan;

👉 Nomor urut di setiap kota
SELECT kota, produk, total,
ROW_NUMBER() OVER(PARTITION BY kota) AS urut_per_kota
FROM penjualan;

👉 Ranking penjualan tertinggi
SELECT kota, produk, total,
RANK() OVER(ORDER BY total DESC) AS ranking
FROM penjualan;

Mirip RANK tapi tidak lompat nomor.
SELECT kota, produk, total,
DENSE_RANK() OVER(ORDER BY total DESC) AS ranking
FROM penjualan;

👉 Ranking produk terlaris di setiap kota
SELECT kota, produk, total,
RANK() OVER(PARTITION BY kota ORDER BY total DESC) AS rank_kota
FROM penjualan;

👉 Total penjualan berjalan per kota
SELECT kota, produk, total,
SUM(total) OVER(PARTITION BY kota ORDER BY total) AS running_total
FROM penjualan;

👉 Ranking produk berdasarkan total penjualan tertinggi
SELECT 
    produk,
    SUM(total) AS total_penjualan,
    DENSE_RANK() OVER(ORDER BY SUM(total) DESC) AS ranking
FROM penjualan
GROUP BY produk;

menampilkan top kota
SELECT *
FROM (
    SELECT kota, produk, total,
    ROW_NUMBER() OVER(PARTITION BY kota ORDER BY total DESC) AS ranking
    FROM penjualan
) AS sub
WHERE ranking = 1;

