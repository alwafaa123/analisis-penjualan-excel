    SUM(CASE WHEN kota='Bandung' THEN total ELSE 0 END) AS Bandung,
    SUM(CASE WHEN kota='Jakarta' THEN total ELSE 0 END) AS Jakarta,
    SUM(CASE WHEN kota='Surabaya' THEN total ELSE 0 END) AS Surabaya

